#!/bin/sh
# Mi 10T (apollo): bind-mount replacements over vendor binaries before the Android container starts.
#  - vndservicemanager.nosel: MIUI's vndservicemanager aborts when SELinux is not active (patch-vsm.py)
#  - audio-hal-stub: keep the container's audio HAL from fighting pulseaudio's HAL over ACDB calibration
#  - storaged: crash-loops (bad_alloc in uid_monitor::get_uid_io_stats_locked), not used on UT -> idle stub
R=/var/lib/lxc/android/rootfs
O=/var/lib/lxc/android/overrides
bind() {
    if [ -f "$1" ] && [ -f "$2" ] && ! grep -q " $2 " /proc/mounts; then
        mount -o bind "$1" "$2"
    fi
}
bind $O/vndservicemanager.nosel $R/vendor/bin/vndservicemanager
bind $O/audio-hal-stub $R/vendor/bin/hw/android.hardware.audio.service
bind $O/audio-hal-stub $R/system/bin/storaged
exit 0
