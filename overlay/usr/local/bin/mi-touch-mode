#!/usr/bin/python3
# mi-touch-mode <mode> [value] : get/set a Xiaomi touch mode via /dev/xiaomi-touch (nt36672c on Mi 10T)
# modes: 7=Touch_Edge_Filter (0=fw default,1..3) 8=Touch_Panel_Orientation (0,1,2,3 = 0/90/180/270 ccw)
import fcntl, struct, sys
SET_CUR, GET_CUR, GET_DEF, GET_MIN, GET_MAX = range(5)
def call(nr, mode, value=0):
    buf = bytearray(struct.pack('256i', mode, value, *([0] * 254)))
    with open('/dev/xiaomi-touch', 'rb+', buffering=0) as f:
        fcntl.ioctl(f, nr, buf, True)  # driver only uses _IOC_NR(cmd)
    return struct.unpack_from('i', buf)[0]
mode = int(sys.argv[1])
if len(sys.argv) > 2:
    call(SET_CUR, mode, int(sys.argv[2]))
print('mode %d: cur=%d def=%d min=%d max=%d' % (mode, call(GET_CUR, mode), call(GET_DEF, mode), call(GET_MIN, mode), call(GET_MAX, mode)))
